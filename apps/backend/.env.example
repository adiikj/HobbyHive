PORT=8000
# App runtime connection. If using Neon, use the *pooled* connection string (host has a "-pooler" segment)
# — the app makes many short queries per request and pooling avoids paying full connection-setup cost each
# time. Do NOT append ?pgbouncer=true: Neon's pooler supports prepared statements, and that flag puts Prisma
# in a compatibility mode that costs ~5 network round trips per query instead of 1 (≈5x slower pages).
DATABASE_URL="postgresql://user:password@localhost:5432/hobbyhive"
# Only needed if DATABASE_URL is a pooled/pgbouncer connection: Prisma Migrate needs a direct (unpooled)
# connection to run migrations. Same DB, non-"-pooler" host. Omit if DATABASE_URL is already unpooled.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/hobbyhive"
CORS_ORIGIN=http://localhost:3000
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=10d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
GOOGLE_GMAIL_ID=
NODE_ENV=development

# Topic-model service (apps/ml). Optional: without it, posting/search work and ML features switch off.
ML_URL=http://localhost:8002
