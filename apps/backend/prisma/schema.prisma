generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  email        String    @unique
  password     String
  bio          String?
  avatarUrl    String?
  otp          String
  otpExpiry    DateTime?
  otpVerified  Boolean   @default(false)
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hobbies               UserHobby[]
  posts                 Post[]
  likes                 Like[]
  comments              Comment[]
  following             Follow[]                  @relation("Follower")
  followers             Follow[]                  @relation("Following")
  notificationsReceived Notification[]            @relation("NotificationRecipient")
  notificationsSent     Notification[]            @relation("NotificationActor")
  conversations         ConversationParticipant[]
  messagesSent          Message[]
  hobbyRoomMessages     HobbyRoomMessage[]
  eventsCreated         Event[]
  eventRsvps            EventRSVP[]
  savedPosts            SavedPost[]
  collections           Collection[]
  challengesCreated     Challenge[]
  progressLogs          ProgressLog[]
}

model Hobby {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  users        UserHobby[]
  posts        Post[]
  roomMessages HobbyRoomMessage[]
  events       Event[]
  challenges   Challenge[]
  progressLogs ProgressLog[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  hobbyId   String
  content   String
  // First photo, kept alongside `images` so "has a photo" filters and older clients keep working
  imageUrl  String?
  images    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challengeId   String?
  progressLogId String?
  // Set when a hive moderator pins the post to the top of the hive
  pinnedAt      DateTime?

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  hobby       Hobby        @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  challenge   Challenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  progressLog ProgressLog? @relation(fields: [progressLogId], references: [id], onDelete: SetNull)

  likes         Like[]
  comments      Comment[]
  notifications Notification[]
  saves         SavedPost[]

  @@index([hobbyId, createdAt])
  @@index([authorId])
  @@index([challengeId])
  @@index([progressLogId, createdAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// A hive's weekly prompt ("Draw your pet"); entries are ordinary posts linked by challengeId
model Challenge {
  id        String   @id @default(cuid())
  hobbyId   String
  creatorId String
  title     String
  prompt    String
  startsAt  DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())

  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entries Post[]

  @@index([hobbyId, endsAt])
}

// A user's series of their own posts in one hive, shown as a timeline ("Learning kickflips")
model ProgressLog {
  id          String   @id @default(cuid())
  userId      String
  hobbyId     String
  title       String
  description String?
  createdAt   DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  entries Post[]

  @@index([userId])
}

// A user's bookmark on a post. Saved at most once per user; optionally filed into one collection.
model SavedPost {
  id           String   @id @default(cuid())
  userId       String
  postId       String
  collectionId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Deleting a collection keeps its posts saved — they just fall back to "All saved"
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([collectionId, createdAt])
}

// A user's named group of saved posts (e.g. "Tutorials", "Inspo")
model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedPosts SavedPost[]

  @@unique([userId, name])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  // Replies are one level deep: parentId always points at a top-level comment
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  NEW_POST
  MENTION
  REPLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  postId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model HobbyRoomMessage {
  id        String   @id @default(cuid())
  hobbyId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  hobby  Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([hobbyId, createdAt])
}

model Event {
  id          String   @id @default(cuid())
  hobbyId     String
  creatorId   String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  createdAt   DateTime @default(now())

  hobby   Hobby       @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   EventRSVP[]

  @@index([hobbyId, startsAt])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

enum HobbyRole {
  MEMBER
  MODERATOR
}

model UserHobby {
  id        String    @id @default(cuid())
  userId    String
  hobbyId   String
  role      HobbyRole @default(MEMBER)
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  @@unique([userId, hobbyId])
  @@index([hobbyId])
}

model PendingUser {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  email       String   @unique
  password    String
  otp         String
  otpExpiry   DateTime
  otpVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
