generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  password     String
  bio          String?
  avatarUrl    String?
  otp          String
  otpExpiry    DateTime?
  otpVerified  Boolean  @default(false)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hobbies  UserHobby[]
  posts    Post[]
  likes    Like[]
  comments Comment[]
}

model Hobby {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  users UserHobby[]
  posts Post[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  hobbyId   String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  hobby  Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  likes    Like[]
  comments Comment[]

  @@index([hobbyId, createdAt])
  @@index([authorId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model UserHobby {
  id        String   @id @default(cuid())
  userId    String
  hobbyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  @@unique([userId, hobbyId])
  @@index([hobbyId])
}

model PendingUser {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  email       String   @unique
  password    String
  otp         String
  otpExpiry   DateTime
  otpVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
