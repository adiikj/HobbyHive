generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  email        String    @unique
  password     String
  bio          String?
  avatarUrl    String?
  otp          String
  otpExpiry    DateTime?
  otpVerified  Boolean   @default(false)
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hobbies               UserHobby[]
  posts                 Post[]
  likes                 Like[]
  comments              Comment[]
  following             Follow[]                  @relation("Follower")
  followers             Follow[]                  @relation("Following")
  notificationsReceived Notification[]            @relation("NotificationRecipient")
  notificationsSent     Notification[]            @relation("NotificationActor")
  conversations         ConversationParticipant[]
  messagesSent          Message[]
  hobbyRoomMessages     HobbyRoomMessage[]
  eventsCreated         Event[]
  eventRsvps            EventRSVP[]
  savedPosts            SavedPost[]
  collections           Collection[]
  challengesCreated     Challenge[]
  progressLogs          ProgressLog[]
  beaAnswers            BeaAnswer[]
  practiceSessions      PracticeSession[]
  skills                UserSkill[]
  goals                 Goal[]
  feedbackGiven         Feedback[]
  guideEntries          GuideEntry[]
}

model Hobby {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  users        UserHobby[]
  posts        Post[]
  roomMessages HobbyRoomMessage[]
  events       Event[]
  challenges   Challenge[]
  progressLogs ProgressLog[]
  beaAnswers   BeaAnswer[]
  practice     PracticeSession[]
  skills       Skill[]
  goals        Goal[]
  guide        GuideEntry[]
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  hobbyId   String
  content   String
  // First photo, kept alongside `images` so "has a photo" filters and older clients keep working
  imageUrl  String?
  images    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challengeId   String?
  progressLogId String?
  // Set when a hive moderator pins the post to the top of the hive
  pinnedAt      DateTime?
  // Set when the author wants feedback: the specific thing they're asking ("is my spotting late?")
  feedbackAsk   String?

  // Topic model (apps/ml): a 384-d sentence embedding (pgvector) for semantic search / similar posts,
  // plus how well the post fits its hive. All nullable: the ML service is optional and runs async.
  embedding       Unsupported("vector(384)")?
  mlHiveScore     Float?
  mlSuggestedHive String?
  mlModelVersion  String?
  // Flagged as likely off-topic for its hive → shown to the hive's moderators; reviewed = they kept it
  flaggedAt       DateTime?
  flagReviewedAt  DateTime?

  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  hobby       Hobby        @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  challenge   Challenge?   @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  progressLog ProgressLog? @relation(fields: [progressLogId], references: [id], onDelete: SetNull)

  likes         Like[]
  comments      Comment[]
  notifications Notification[]
  saves         SavedPost[]
  // Set when this post was shared from a practice session
  practiceSession PracticeSession?
  feedback        Feedback[]
  guideEntries    GuideEntry[]

  @@index([hobbyId, createdAt])
  @@index([authorId])
  @@index([challengeId])
  @@index([hobbyId, feedbackAsk])
  @@index([progressLogId, createdAt])
  @@index([hobbyId, flaggedAt])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

// A hive's weekly prompt ("Draw your pet"); entries are ordinary posts linked by challengeId
model Challenge {
  id        String   @id @default(cuid())
  hobbyId   String
  creatorId String
  title     String
  prompt    String
  startsAt  DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())

  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entries Post[]

  @@index([hobbyId, endsAt])
}

// A user's series of their own posts in one hive, shown as a timeline ("Learning kickflips")
model ProgressLog {
  id          String   @id @default(cuid())
  userId      String
  hobbyId     String
  title       String
  description String?
  createdAt   DateTime @default(now())

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  entries Post[]

  @@index([userId])
}

// A user's bookmark on a post. Saved at most once per user; optionally filed into one collection.
model SavedPost {
  id           String   @id @default(cuid())
  userId       String
  postId       String
  collectionId String?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Deleting a collection keeps its posts saved — they just fall back to "All saved"
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([collectionId, createdAt])
}

// A user's named group of saved posts (e.g. "Tutorials", "Inspo")
model Collection {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedPosts SavedPost[]

  @@unique([userId, name])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  // Replies are one level deep: parentId always points at a top-level comment
  parentId  String?
  content   String
  createdAt DateTime @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  NEW_POST
  MENTION
  REPLY
  FEEDBACK
  FEEDBACK_HELPFUL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  postId    String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model HobbyRoomMessage {
  id        String   @id @default(cuid())
  hobbyId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  hobby  Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([hobbyId, createdAt])
}

model Event {
  id          String   @id @default(cuid())
  hobbyId     String
  creatorId   String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  createdAt   DateTime @default(now())

  hobby   Hobby       @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  rsvps   EventRSVP[]

  @@index([hobbyId, startsAt])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

enum HobbyRole {
  MEMBER
  MODERATOR
}

model UserHobby {
  id        String    @id @default(cuid())
  userId    String
  hobbyId   String
  role      HobbyRole @default(MEMBER)
  createdAt DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby Hobby @relation(fields: [hobbyId], references: [id], onDelete: Cascade)

  @@unique([userId, hobbyId])
  @@index([hobbyId])
}

model PendingUser {
  id          String   @id @default(cuid())
  name        String
  username    String   @unique
  email       String   @unique
  password    String
  otp         String
  otpExpiry   DateTime
  otpVerified Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One Ask Bea answer, kept so users can rate it (👍/👎) and so answer quality can be measured over time
model BeaAnswer {
  id            String   @id @default(cuid())
  userId        String
  hobbyId       String?
  question      String
  // "none" (nothing relevant enough, so Bea said so), "extractive", "generated" or "mixed" (see apps/ml)
  mode          String
  evidenceCount Int
  // Best retrieval match (meaning score), to relate ratings to retrieval quality
  topScore      Float?
  // null = not rated yet
  helpful       Boolean?
  ratedAt       DateTime?
  createdAt     DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby Hobby? @relation(fields: [hobbyId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

// Time spent practising a hobby; sessions feed streaks and can be shared to the hive as a post
model PracticeSession {
  id          String   @id @default(cuid())
  userId      String
  hobbyId     String
  startedAt   DateTime
  durationMin Int
  // What they worked on ("turns", "chord changes")
  focus       String
  // Private to the author
  note        String?
  // How it went: "rough" | "okay" | "great"
  feel        String?
  // Set when the session was shared to the hive as a post
  postId      String?  @unique
  // The skill this session worked on, if they tagged one
  skillId     String?
  createdAt   DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  post  Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([hobbyId, startedAt])
  @@index([userId, skillId])
}

// A hive's curated skill map: small trees, each skill building on the one before it
model Skill {
  id          String  @id @default(cuid())
  hobbyId     String
  // Stable key used by the seed ("single-pirouette")
  slug        String
  name        String
  description String
  // 1 = first steps; higher tiers build on lower ones
  tier        Int
  // Display order within a tier
  position    Int     @default(0)
  // The skill this one builds on (null for roots)
  parentId    String?

  hobby    Hobby             @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  parent   Skill?            @relation("SkillTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Skill[]           @relation("SkillTree")
  learners UserSkill[]
  goals    Goal[]
  sessions PracticeSession[]
  guide    GuideEntry[]

  @@unique([hobbyId, slug])
  @@index([hobbyId, tier])
}

enum SkillStatus {
  LEARNING
  DONE
}

// Where someone is with a skill
model UserSkill {
  id          String      @id @default(cuid())
  userId      String
  skillId     String
  status      SkillStatus @default(LEARNING)
  startedAt   DateTime    @default(now())
  completedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  DROPPED
}

// Something to work towards in a hive, usually a skill, optionally by a date
model Goal {
  id         String     @id @default(cuid())
  userId     String
  hobbyId    String
  skillId    String?
  title      String
  targetDate DateTime?
  status     GoalStatus @default(ACTIVE)
  createdAt  DateTime   @default(now())
  achievedAt DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hobby Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  skill Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([hobbyId])
}

// A structured reply to a "feedback wanted" post: what's working, one thing to try, and where to look.
// The post's author can mark it helpful, which is what mentor reputation is built from.
model Feedback {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  working   String
  tryNext   String
  // Where to look: a clip timestamp ("0:42") or a photo ("photo 2")
  at        String?
  helpfulAt DateTime?
  createdAt DateTime  @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId])
  @@index([authorId, helpfulAt])
}

// A post a moderator or mentor added to their hive's guide, optionally under a skill, with a short note on why
model GuideEntry {
  id        String   @id @default(cuid())
  hobbyId   String
  skillId   String?
  postId    String
  addedById String
  note      String?
  createdAt DateTime @default(now())

  hobby   Hobby  @relation(fields: [hobbyId], references: [id], onDelete: Cascade)
  skill   Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  post    Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  addedBy User   @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([hobbyId, postId])
  @@index([hobbyId, skillId])
}
