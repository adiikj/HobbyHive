{
  "name": "hobbyhive",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @hobbyhive/frontend dev",
    "dev:api": "pnpm --filter @hobbyhive/backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @hobbyhive/backend db:migrate",
    "db:studio": "pnpm --filter @hobbyhive/backend db:studio",
    "test": "pnpm --filter @hobbyhive/backend test && pnpm --filter @hobbyhive/frontend test",
    "test:e2e:seed": "pnpm --filter @hobbyhive/backend db:seed:e2e",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
